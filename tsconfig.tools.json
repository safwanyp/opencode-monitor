{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    // Mirrors the Nuxt alias so test files can import server code that uses it.
    "baseUrl": ".",
    "paths": {
      "#shared/*": ["./shared/*"]
    },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },

  // Covers what no generated Nuxt project does: shared/, scripts/, and the
  // plain tests. Deliberately does NOT have Nuxt's auto-import globals, so a
  // missing import here cannot hide behind them.
  "include": ["shared/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],

  // Tests that touch app code need Nuxt's globals, so they live under
  // test/nuxt/ and are typechecked by Nuxt's own tsconfig.app.json instead.
  "exclude": ["test/nuxt/**"]
}
