{
  "name": "opencode-monitor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "description": "Read-only local monitor for OpenCode's service logs and sessions",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.tools.json",
    "verify:logfmt": "node scripts/verify-logfmt.ts \"${XDG_DATA_HOME:-$HOME/.local/share}/opencode/log/opencode.log\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
